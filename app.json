{
  "expo": {
    "name": "PasseRyder",
    "slug": "moto",
    "version": "1.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "icon": "./assets/images/icon.png",
    "scheme": "passeryder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.passeryder.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.passeryder.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PasseRyder utilise ta position pour l'afficher sur la carte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PasseRyder accède à tes photos pour ton profil, tes motos, tes stories et tes messages.",
          "cameraPermission": "PasseRyder utilise l'appareil photo pour ton profil, tes motos, tes stories et tes messages.",
          "microphonePermission": "PasseRyder utilise le micro pour le son de tes stories vidéo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0EA5E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0EA5E9"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c86f6ae-fb9f-4dea-9025-e00fcf5864b7"
      }
    },
    "owner": "turtel",
    "updates": {
      "url": "https://u.expo.dev/8c86f6ae-fb9f-4dea-9025-e00fcf5864b7"
    }
  }
}
